# Environment variables for apps/frontend
#
# These are PLACEHOLDERS — every value is intentionally empty.
# Copy this file, then fill it from Neon:
#
#   cp .env.example .env
#   neon env pull            # writes .env (project is linked via .neon)
#   neon deploy              # applies neon.ts, then pulls env
#
# NEVER commit .env — it holds live credentials. Only this file is tracked.

# Postgres (pooled for the app; unpooled/direct for drizzle-kit migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Object Storage (private bucket, S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Realtime (beta)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
